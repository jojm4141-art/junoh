/* 기본 리셋 */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Malgun Gothic', sans-serif;
}

body {
  background-color: #f0f0f0;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

/* 전체 스마트폰 디바이스 외곽선 및 배경 */
.device-frame {
  width: 360px;
  background-color: #eeeeee;
  border: 2px solid #333333;
  border-radius: 40px;
  padding: 20px 15px 0 15px;
  overflow: hidden;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  gap: 15px;
}

/* 1. 헤드 영역 */
.header-section {
  display: flex;
  gap: 10px;
  align-items: center;
}

.search-bar {
  flex: 1;
  background-color: #ffffff;
  border: 1.5px solid #333333;
  border-radius: 12px;
  height: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 14px;
  color: #333333;
}

.action-btn {
  width: 60px;
  height: 40px;
  background-color: #ffffff;
  border: 1.5px solid #333333;
  border-radius: 12px;
  font-size: 13px;
  cursor: pointer;
}

/* 구분선 (검은 띠) */
.divider {
  width: 100%;
  height: 20px;
  background-color: #000000;
  border-radius: 4px;
}

/* 2 & 3. Grid 공통 레이아웃 (본문 및 작업 영역) */
.grid-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.card {
  background-color: #ffffff;
  border: 1.5px solid #333333;
  border-radius: 16px;
  height: 90px;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  font-size: 15px;
  font-weight: bold;
  color: #333333;
  line-height: 1.3;
}

/* 하단 스트라이프 패턴 영역 */
.footer-pattern {
  height: 50px;
  margin-top: 5px;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  padding: 0 10px;
}

.stripe {
  width: 25px;
  height: 100%;
  background-color: #000000;
  transform: skewX(-15deg); /* 사선 모양 효과 */
  border-top-left-radius: 3px;
  border-top-right-radius: 3px;
}
